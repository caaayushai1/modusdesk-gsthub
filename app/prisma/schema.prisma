datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. Practice-Wide Filing Status Matrix
model GSTFilingStatus {
  id              String   @id @default(cuid())
  clientId        String   // Matches ModusDesk Client.id
  clientCode      String   // e.g. "001A"
  clientName      String
  gstin           String   // 15-character GSTIN
  stateCode       String   // e.g. "27"
  period          String   // Format: "YYYY-MM" (e.g. "2026-07")
  financialYear   String   // Format: "YYYY-YYYY" (e.g. "2026-2027")
  isQrmp          Boolean  @default(false)
  
  // GSTR-1 / IFF Details
  gstr1Status     String   @default("PENDING") // "FILED" | "PENDING" | "OVERDUE"
  gstr1Arn        String?
  gstr1FilingDate DateTime?
  
  // GSTR-3B Details
  gstr3bStatus    String   @default("PENDING") // "FILED" | "PENDING" | "OVERDUE"
  gstr3bArn       String?
  gstr3bFilingDate DateTime?
  
  // GSTR-2B Details
  gstr2bGenerated Boolean  @default(false)
  
  lastSyncedAt    DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([clientId, gstin, period])
  @@index([clientId])
  @@index([period])
  @@index([gstr1Status, gstr3bStatus])
}

// 2. GSTR-2B vs Books (Tally) Reconciliation Records
model ITCReconciliationRun {
  id                  String   @id @default(cuid())
  clientId            String
  clientName          String
  gstin               String
  period              String   // e.g. "2026-07"
  financialYear       String   // e.g. "2026-2027"
  
  totalBooksInvoices  Int      @default(0)
  total2bInvoices     Int      @default(0)
  exactMatchCount     Int      @default(0)
  valueMismatchCount  Int      @default(0)
  missingIn2bCount    Int      @default(0)
  missingInBooksCount Int      @default(0)
  ineligibleCount     Int      @default(0)
  
  booksTotalTaxable   Decimal  @default(0)
  booksTotalTax       Decimal  @default(0)
  gstr2bTotalTaxable  Decimal  @default(0)
  gstr2bTotalTax      Decimal  @default(0)
  eligibleClaimableItc Decimal @default(0)
  
  summaryJson         String   // JSON string of summary statistics
  itemsJson           String   // JSON string of categorized line items
  
  runAt               DateTime @default(now())
  runByStaffId        String
  runByStaffName      String

  @@index([clientId, period])
  @@index([gstin, financialYear])
}

// 3. Electronic Cash & Credit Ledger Snapshots
model GSTLedgerSnapshot {
  id               String   @id @default(cuid())
  clientId         String
  clientName       String
  gstin            String
  
  igstCredit       Decimal  @default(0)
  cgstCredit       Decimal  @default(0)
  sgstCredit       Decimal  @default(0)
  cessCredit       Decimal  @default(0)
  totalCredit      Decimal  @default(0)
  
  cashTax          Decimal  @default(0)
  cashInterest     Decimal  @default(0)
  cashPenalty      Decimal  @default(0)
  cashFee          Decimal  @default(0)
  cashOthers       Decimal  @default(0)
  totalCash        Decimal  @default(0)
  
  liabilityBalance Decimal  @default(0)
  breakdownJson    String   // JSON string of detailed heads
  snapshotDate     DateTime @default(now())

  @@index([clientId, gstin])
}

// 4. CA MIS Comparison Cache
model MISComparisonCache {
  id              String   @id @default(cuid())
  clientId        String
  clientName      String
  gstin           String
  financialYear   String   // e.g. "2026-2027"
  reportType      String   // "GSTR1_VS_3B" | "GSTR2B_VS_3B" | "ANNUAL_SUMMARY"
  comparisonData  String   // JSON string
  hasDiscrepancy  Boolean  @default(false)
  generatedAt     DateTime @default(now())

  @@unique([clientId, gstin, financialYear, reportType])
  @@index([clientId, financialYear])
}

// 5. Composition Scheme Quarterly Stock & Tax Ledger
model CompositionSchemeLedger {
  id                String   @id @default(cuid())
  clientId          String   // Matches ModusDesk Client.id
  clientCode        String   // e.g. "001A"
  clientName        String
  gstin             String   // 15-character GSTIN
  financialYear     String   // e.g. "2026-27"
  quarter           String   // "Q1" | "Q2" | "Q3" | "Q4"
  
  // Stock & Purchase Dynamics
  openingStock      Decimal  @default(0) // Carried from previous quarter's closing stock or manual
  totalPurchases    Decimal  @default(0) // Inclusive of tax, excluding RCM purchases
  rcmTaxableValue   Decimal  @default(0) // Inward supplies subject to reverse charge (Sec 9(3)/9(4))
  rcmTaxPayable     Decimal  @default(0) // Tax on RCM (CGST + SGST or IGST)
  gpMargin          Decimal  @default(10.0) // Gross Profit Margin % (default 10%)
  
  // Sales & Computation
  salesMode         String   @default("ACTUAL") // "ACTUAL" | "DERIVED"
  actualSales       Decimal  @default(0) // Turnover
  taxRateOnSales    Decimal  @default(1.0) // 1.0% (Traders/Mfg), 5.0% (Restaurant), 6.0% (Services)
  taxPayableOnSales Decimal  @default(0) // actualSales * (taxRateOnSales / 100)
  totalCmp08Tax     Decimal  @default(0) // taxPayableOnSales + rcmTaxPayable
  
  // Closing Stock Formula: Opening + Purchases + (GP Margin * Sales) - Sales
  closingStock      Decimal  @default(0)
  
  // Filing & Statutory Status
  status            String   @default("DRAFT") // "DRAFT" | "READY_TO_FILE" | "FILED"
  arn               String?
  filedAt           DateTime?
  notes             String?
  
  inwardInvoices    CompositionInwardInvoice[]
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([clientId, gstin, financialYear, quarter])
  @@index([clientId, financialYear])
  @@index([quarter])
}

// 6. Ingested GSTR-2A Inward Invoices for Composition Dealers
model CompositionInwardInvoice {
  id              String   @id @default(cuid())
  ledgerId        String?
  ledger          CompositionSchemeLedger? @relation(fields: [ledgerId], references: [id], onDelete: SetNull)
  clientId        String
  gstin           String   // Recipient GSTIN
  financialYear   String   // e.g. "2026-27"
  quarter         String   // "Q1" | "Q2" | "Q3" | "Q4"
  
  supplierGstin   String
  supplierName    String?
  invoiceNumber   String
  invoiceDate     String
  invoiceValue    Decimal  @default(0)
  taxableValue    Decimal  @default(0)
  igst            Decimal  @default(0)
  cgst            Decimal  @default(0)
  sgst            Decimal  @default(0)
  cess            Decimal  @default(0)
  rate            Decimal  @default(0)
  isRcm           Boolean  @default(false)
  source          String   @default("GSTR2A_COMPANION") // "GSTR2A_COMPANION" | "EXCEL_UPLOAD" | "MANUAL"
  
  createdAt       DateTime @default(now())

  @@index([clientId, financialYear, quarter])
  @@index([supplierGstin])
  @@index([isRcm])
}
